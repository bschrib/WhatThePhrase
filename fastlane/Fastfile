# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
  # Load App Store Connect API key from environment variables
  # Set via: source <(op inject -i fastlane.op --account=3W2HMD2KKRGNBNJI3UD2NQ726A)
  private_lane :load_asc_api_key do
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )
  end

  desc "Push a new beta build to TestFlight"
  lane :beta do
    api_key = load_asc_api_key

    # Sync certificates
    match(type: "appstore", api_key: api_key)

    # Fetch latest build number from TestFlight and increment
    current = latest_testflight_build_number(
      app_identifier: "com.roguedeveloper.WhatThePhrase",
      api_key: api_key
    )
    increment_build_number(
      xcodeproj: "WhatThePhrase.xcodeproj",
      build_number: current + 1
    )
    build_app(scheme: "WhatThePhrase")

    # Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      changelog: File.read("fastlane/metadata/en-US/release_notes.txt")
    )
  end

  desc "Push a new build to the App Store (Public Release)"
  lane :release do
    api_key = load_asc_api_key

    # Sync certificates
    match(type: "appstore", api_key: api_key)

    # Fetch latest build number from App Store and increment
    current = app_store_build_number(
      app_identifier: "com.roguedeveloper.WhatThePhrase",
      api_key: api_key,
      live: false
    )
    increment_build_number(
      xcodeproj: "WhatThePhrase.xcodeproj",
      build_number: current + 1
    )
    build_app(scheme: "WhatThePhrase")

    # Upload to App Store
    upload_to_app_store(
      api_key: api_key,
      skip_metadata: false,
      skip_screenshots: false,
      skip_binary_upload: false,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      screenshots_path: "screenshots",
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        export_compliance_uses_encryption: false
      }
    )
  end

  desc "Generate screenshots using Snapshot"
  lane :screenshots do
    snapshot(
      project: "WhatThePhrase.xcodeproj",
      scheme: "WhatThePhraseScreenShots"
    )
  end

  desc "Upload only screenshots (no build)"
  lane :upload_screenshots do
    api_key = load_asc_api_key
    upload_to_app_store(
      api_key: api_key,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      force: true,
      screenshots_path: "screenshots",
      precheck_include_in_app_purchases: false,
      submit_for_review: false
    )
  end

  desc "Build for local development"
  lane :develop do
    api_key = load_asc_api_key
    match(type: "development", api_key: api_key)
    build_app(
      project: "WhatThePhrase.xcodeproj",
      scheme: "WhatThePhrase",
      configuration: "Debug",
      export_method: "development",
      skip_package_ipa: true
    )
  end

  desc "Build locally without certificates (for testing compilation)"
  lane :build_local do
    build_app(
      project: "WhatThePhrase.xcodeproj",
      scheme: "WhatThePhrase",
      configuration: "Debug",
      sdk: "iphonesimulator",
      skip_codesigning: true,
      skip_package_ipa: true
    )
  end

  lane :generate_appicon do
    appicon(
      appicon_image_file: 'WhatThePhrase/Assets/Images/AppIcon.png',
      appicon_devices: [:ipad, :iphone, :ios_marketing],
      appicon_path: "WhatThePhrase/Assets.xcassets"
    )
  end

  lane :generate_launch_image do
    appicon(
      appicon_image_file: "WhatThePhrase/Assets/Images/AppLaunchScreen.png",
      appicon_devices: [:iphone],
      appicon_path: "WhatThePhrase/Assets.xcassets",
      appicon_name: "LaunchImage"
    )
  end
end
